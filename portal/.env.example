# TidyTool portal — Supabase config.
# The key is PUBLIC (publishable / anon). Safe to ship to the browser; access is bounded by RLS.
# Copy this file to .env.local and fill in the values from your Supabase project settings.

NEXT_PUBLIC_SUPABASE_URL=https://tkrrvpoupekrjqditupi.supabase.co

# Preferred: the modern publishable key (sb_publishable_...). The app reads this first.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Fallback: the legacy anon JWT key. Used only if PUBLISHABLE_KEY is unset.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Where Supabase magic-link emails redirect back to. Use the deployed origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SECRET — server only, never NEXT_PUBLIC_. Required for the admin "Invite to
# portal" / set-password actions. Get it from Supabase → Settings → API keys.
# Set this in Vercel's environment variables too (Production + Preview).
SUPABASE_SECRET_KEY=sb_secret_xxx
# Legacy fallback name (used only if SUPABASE_SECRET_KEY is unset):
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt
